<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StepStats.MainPage">

    <StackLayout>
        <Frame BackgroundColor="#2196F3" Padding="24" CornerRadius="0">
            <Label Text="Step-Stats" HorizontalTextAlignment="Center" TextColor="White" FontSize="36"/>
        </Frame>
        <Label x:Name="_locationLabel" FontSize="16" Padding="30,0,30,0"/>
        <Label x:Name="_stepsLabel" FontSize="16" FontAttributes="Bold" Padding="30,0,30,0"/>
        <Label x:Name="_avgDistanceLabel" FontSize="16" FontAttributes="Bold" Padding="30,0,30,0" HorizontalTextAlignment="Center"/>
    </StackLayout>

</ContentPage>
